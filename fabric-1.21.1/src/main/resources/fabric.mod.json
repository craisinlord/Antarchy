{
  "schemaVersion": 1,
  "id": "${mod_id}",
  "version": "${version}",
  "name": "${mod_name}",
  "description": "${mod_description}",
  "authors": [
    "${mod_author}"
  ],
  "contact": {
    "homepage": "${homepage_url}",
    "sources": "${sources_url}",
    "issues": "${issues_url}"
  },
  "license": "${license}",
  "environment": "*",
  "icon": "${logo_fabric}",
  "entrypoints": {
    "main": [
      "com.craisinlord.antarchy.fabric.AntarchyFabric"
    ],
    "client": [
      "com.craisinlord.antarchy.fabric.client.AntarchyFabricClient"
    ],
    "modmenu": [
      "com.craisinlord.antarchy.fabric.client.AntarchyModMenuIntegration"
    ],
    "sodium:config_api_user": [
      "com.craisinlord.antarchy.content.client.renderer.PrimordialGrassSodiumOptions"
    ]
  },
  "mixins": [
    "antarchy-common.mixins.json",
    "antarchy-fabric.mixins.json",
    "antarchy-compat.mixins.json",
    "antarchy-fabric-compat.mixins.json"
  ],
  "depends": {
    "antos": ">=1.6.5",
    "anthology": ">=1.0.7",
    "fabricloader": ">=${fabric_loader_version}",
    "minecraft": "~${minecraft_version}",
    "java": ">=21",
    "fabric-api": "*",
    "architectury": "${architectury_api_version}",
    "integrated_api": ">=1.9.2",
    "geckolib": "*",
    "sizeable_foliage": "*"
  },
  "breaks": {
    "infinity": "<2.7.3",
    "apple_cows": "*",
    "hoverboards": "*"
  },
  "suggests": {
    "modmenu": "*",
    "cloth-config": "*"
  }
}
